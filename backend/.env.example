# MI YONE backend configuration.
# Copy this file to `.env` in the backend/ folder and edit what you need —
# every value here shows the DEFAULT, so you only need lines you're changing.
# NEVER commit your real .env (it's gitignored): keys and passwords stay local.

# --- Database ---------------------------------------------------------------
MIYONE_DATABASE_URL=postgresql+psycopg2://miyone:miyone_dev@localhost:5432/miyone

# --- Environment ------------------------------------------------------------
# dev | demo | production. Outside dev: Secure cookies are forced on, /api/docs
# is off. Outside dev/demo: the demo seed and migration downgrades REFUSE to run.
MIYONE_ENV=dev
# Set true when serving over HTTPS in production (marks the session cookie Secure):
MIYONE_COOKIE_SECURE=false

# --- Partner AI (optional) --------------------------------------------------
# "local" = built-in deterministic composer (no key needed, honest default).
# "anthropic" = Partner replies + photo->product suggestions use the AI model,
# grounded on your real records only; falls back to local on any failure.
MIYONE_AI_PROVIDER=local
MIYONE_AI_API_KEY=
MIYONE_AI_MODEL=claude-sonnet-5

# --- Market research (optional) ---------------------------------------------
# The Partner's THIRD knowledge lane. Records and general business guidance
# work with no key at all; this switch only controls live market research.
# "none" = research is honestly unavailable ("I can't verify that right now").
# "anthropic" = real web search with citations, using MIYONE_AI_API_KEY above.
#   Every research answer must carry sources — an answer with no source is
#   never shown as a finding. Searches are billed by Anthropic per search.
# Only the question and "the owner runs a small shop in Sierra Leone" leave
# MI YONE. No figures, customer names, or product lists are ever sent.
MIYONE_RESEARCH_PROVIDER=none
MIYONE_RESEARCH_MODEL=claude-sonnet-5

# --- Product photos ---------------------------------------------------------
# On managed hosting this MUST be on a persistent disk (render.yaml: /var/data/uploads).
MIYONE_UPLOAD_DIR=./var/uploads

# --- WhatsApp catalog import (optional) --------------------------------------
# "test" = clearly-labeled sample adapter (no credentials needed).
# "live" = real Meta Graph API; requires both credentials below.
MIYONE_WA_MODE=test
MIYONE_WA_ACCESS_TOKEN=
MIYONE_WA_BUSINESS_ACCOUNT_ID=
